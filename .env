# Configuración para Wikidata
SPARQL_BACKEND=wikidata
SPARQL_ENDPOINT_URL=https://query.wikidata.org/sparql

SPARQL_USER=rdf-gis-explorer/0.1 (https://github.com/marventu94/RDFGISExplorer; mailto:mar_venturino@hotmail.com)
SPARQL_TIMEOUT_MS=10000
SPARQL_DEFAULT_LIMIT=100
SPARQL_MAX_LIMIT=500

BACKEND_PORT=3000
FRONTEND_PORT=4200
RDF_EXPLORER_PORT=4201
RDF_GIS_EXPLORER_PORT=4202

CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# --- Límites de queries y visualización (se exponen a los frontends vía /api/config) ---
# Cap de nodos de la vista de grafo del GIS
#GIS_GRAPH_MAX_NODES=300
# Tamaño de lote por defecto y opciones del selector (CSV)
#GIS_LOT_DEFAULT_SIZE=300
#GIS_LOT_SIZE_OPTIONS=100,300,500
# Opciones de paginación de la tabla (CSV)
#GIS_TABLE_PAGE_SIZE_OPTIONS=50,100,200
# Tope de filas del export completo a CSV y piso del reintento adaptativo de página
#EXPORT_MAX_ROWS=50000
#EXPORT_MIN_PAGE_SIZE=250
# Tope de valores en el top categórico del summary
#SUMMARY_TOP_CATEGORICAL_LIMIT=12
# TTL del cache de predicados del adaptador (ms)
#SPARQL_PREDICATE_CACHE_TTL_MS=3600000
# Tope del payload de dashboards (bytes)
#DASHBOARD_MAX_PAYLOAD_BYTES=1048576
