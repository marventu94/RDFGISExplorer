# SPARQL Endpoint — fase 1: wikidata | fase 2: millenniumdb
SPARQL_BACKEND=wikidata
SPARQL_ENDPOINT_URL=https://query.wikidata.org/sparql

# OBLIGATORIO para Wikidata (política Wikimedia — sin esto responde 429)
SPARQL_USER_AGENT=rdf-gis-explorer/0.1 (https://github.com/your-org/rdf-gis-explorer; your-email@example.com)

SPARQL_TIMEOUT_MS=10000
SPARQL_DEFAULT_LIMIT=500
SPARQL_MAX_LIMIT=2000

BACKEND_PORT=3000
FRONTEND_PORT=4200

SQLITE_PATH=./data/curation.db
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info
