# Entorno aislado para el ensayo de evaluación C1-C5.
# Copiar a .env.evaluation.local y completar endpoint/credenciales.
SPARQL_BACKEND=graphdb
SPARQL_ENDPOINT_URL=<GRAPHDB_REPOSITORY_URL>
SPARQL_USERNAME=<usuario>
SPARQL_PASSWORD=<contraseña>
SPARQL_USER=rdf-gis-explorer-evaluation/1.0
SPARQL_TIMEOUT_MS=300000
SPARQL_DEFAULT_LIMIT=100
SPARQL_MAX_LIMIT=1000
SPARQL_PREFIXES_PATH=backend/config/prefixes.graphdb.json
DASHBOARDS_SQLITE_PATH=./data/evaluation.sqlite
BACKEND_PORT=3000
FRONTEND_PORT=4200
RDF_EXPLORER_PORT=4201
RDF_GIS_EXPLORER_PORT=4202
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
GIS_GRAPH_MAX_NODES=300
GIS_LOT_DEFAULT_SIZE=300
GIS_LOT_SIZE_OPTIONS=100,300,500
GIS_TABLE_PAGE_SIZE_OPTIONS=50,100,200
