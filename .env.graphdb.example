# Configuración para GraphDB local
# Copiar este archivo a .env.graphdb y completar con las credenciales reales
SPARQL_BACKEND=graphdb
SPARQL_ENDPOINT_URL=http://<host>:<port>/repositories/<repo-id>
SPARQL_USERNAME=usuario
SPARQL_PASSWORD=contraseña

# Query opcional para busqueda de entidades desde RDF Explorer.
# Si no se define, usa rdfs:label + FILTER regex.
# Reemplaza $keyword y $limit.
# SPARQL_ENTITY_SEARCH_QUERY=SELECT DISTINCT ?uri ?label WHERE { ?uri <http://www.w3.org/2000/01/rdf-schema#label> ?label . FILTER regex(?label, "$keyword", "i") } LIMIT $limit

SPARQL_USER_AGENT=rdf-gis-explorer/0.1 (https://github.com/your-org/rdf-gis-explorer; your-email@example.com)
SPARQL_TIMEOUT_MS=10000
SPARQL_DEFAULT_LIMIT=500
SPARQL_MAX_LIMIT=2000

BACKEND_PORT=3000
FRONTEND_PORT=4200
RDF_EXPLORER_PORT=4201
RDF_GIS_EXPLORER_PORT=4202

SQLITE_PATH=./data/curation.db
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
LOG_LEVEL=info
