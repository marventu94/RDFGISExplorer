{
  "name": "rdf-gis-explorer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "concurrently --raw --names backend,shell,explorer,gis \"pnpm run dev:backend\" \"pnpm run dev:shell\" \"pnpm run dev:explorer\" \"pnpm run dev:gis\"",
    "dev:backend": "cd backend && pnpm run start:dev",
    "dev:shell": "cd frontend/app_shell && pnpm run start",
    "dev:explorer": "cd frontend/rdf_explorer && pnpm run start",
    "dev:gis": "cd frontend/rdf_gis_explorer && pnpm run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "http-server": "^14.1.1"
  }
}
